# Supabase Migration Target
# Use the publishable key (or the legacy anon key) in the browser.
# Never put a Supabase service-role key in this file or in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key_here
# Keep Firebase during the data migration; switch to supabase only after import verification.
VITE_DATA_PROVIDER=firebase

# Existing Firebase Configuration (temporary during migration)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com

# Whitelisted Email Addresses (comma separated)
VITE_ALLOWED_EMAILS=admin@gmail.com,operator@gmail.com,user@example.com
