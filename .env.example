# Supabase Migration Target
# Use the publishable key (or the legacy anon key) in the browser.
# Never put a Supabase service-role key in this file or in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key_here
# Supabase is the only application data provider.
# Supabase public client configuration.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key_here

# Whitelisted Email Addresses (comma separated)
VITE_ALLOWED_EMAILS=admin@gmail.com,operator@gmail.com,user@example.com
